// StabMouse — window shell and dashboard.
//
// Implements docs/gui.md. The values here are not arbitrary: the colour sets, the 4px grid,
// the 13/11/15px type scale and the 4px/6px radii are all fixed by that document, so changing
// one is a decision to be recorded there rather than a tweak to be made here.

// Every colour and metric in one place, so a theme change is one edit rather than a sweep.
//
// `accent` is filled in from Rust with the desktop's own selection colour. It stays a property
// rather than a constant because reading it is what makes the application feel native instead
// of like a foreign window that happens to be dark.
export global Theme {
    in property <color> accent: #6ea8fe;
    // Set from Rust rather than read from Slint's palette, so the manual override required by
    // the spec has somewhere to live.
    in property <bool> dark: true;

    out property <color> ground: dark ? #1b1b1f : #fafafb;
    out property <color> surface: dark ? #25252b : #ffffff;
    out property <color> text: dark ? #d8d8de : #1e1e24;
    out property <color> muted: dark ? #8a8a93 : #6b6b74;
    out property <color> line: dark ? #33333a : #e4e4e9;

    out property <color> warning: #d99a2b;
    out property <color> error: #d9534f;
    out property <color> success: #4caf7d;

    // 4px grid.
    out property <length> gap: 8px;
    out property <length> pad: 16px;
    out property <length> radius-control: 4px;
    out property <length> radius-card: 6px;

    out property <length> size-base: 13px;
    out property <length> size-muted: 11px;
    out property <length> size-heading: 15px;
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.line;
}

// Accent is reserved for interactive state and selection — never decoration (gui.md).
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled-item: true;
    callback clicked();

    height: 32px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.accent.with-alpha(0.16)
              : touch.has-hover ? Theme.line.with-alpha(0.5)
              : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: label;
            vertical-alignment: center;
            font-size: Theme.size-base;
            // Medium for the selected item; the spec allows regular and medium only, so
            // emphasis cannot reach for bold.
            font-weight: selected ? 600 : 400;
            color: root.enabled-item ? (selected ? Theme.accent : Theme.text) : Theme.muted;
        }
    }

    touch := TouchArea {
        enabled: root.enabled-item;
        clicked => { root.clicked(); }
    }
}

component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: danger ? Theme.error : (primary ? Theme.accent : Theme.line);
    background: touch.pressed ? Theme.line
              : (primary ? Theme.accent.with-alpha(touch.has-hover ? 0.28 : 0.18)
                         : (touch.has-hover ? Theme.line.with-alpha(0.5) : transparent));

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: label;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: Theme.size-base;
            color: danger ? Theme.error : (primary ? Theme.accent : Theme.text);
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One stage of the active pipeline. The strip is the answer to "is it actually doing
// anything", which is the first question a user has and the hardest to answer otherwise.
component PipelineStage inherits Rectangle {
    in property <string> label;
    in property <bool> active: true;

    height: 26px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: active ? Theme.accent.with-alpha(0.4) : Theme.line;
    background: active ? Theme.accent.with-alpha(0.10) : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: label;
            vertical-alignment: center;
            // Monospace: these are config keys, and the spec puts keys in monospace so file
            // knowledge and interface knowledge stay the same knowledge.
            font-family: "monospace";
            font-size: Theme.size-muted;
            color: active ? Theme.text : Theme.muted;
        }
    }
}

// Inline in the flow, never a dismissible banner (gui.md) — a warning that can be swiped away
// is a warning that will be, and these explain things that otherwise look like breakage.
component NoticeCard inherits Card {
    in property <string> title;
    in property <string> body;
    in property <color> tone: Theme.warning;
    in property <string> action;
    callback acted();

    border-color: tone.with-alpha(0.5);
    background: tone.with-alpha(0.08);

    VerticalLayout {
        padding: Theme.pad;
        spacing: 4px;

        Text {
            text: title;
            font-size: Theme.size-base;
            font-weight: 600;
            color: tone;
        }
        Text {
            text: body;
            font-size: Theme.size-muted;
            color: Theme.text;
            wrap: word-wrap;
        }
        if action != "": HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            Button {
                label: action;
                clicked => { root.acted(); }
            }
        }
    }
}

// One row of the preset editor: either a stage heading or one of its parameters.
//
// A single flat list rather than stages each holding parameters — Slint models do not nest,
// and a header flag carries the structure without the nesting. It also lets a stage with no
// parameters still draw its heading, which a nested model would have hidden.
struct EditorRow {
    is-header: bool,
    stage-index: int,
    stage-kind: string,
    stage-label: string,
    stage-enabled: bool,
    can-up: bool,
    can-down: bool,

    key: string,
    label: string,
    unit: string,
    help: string,
    // "float" | "bool" | "choice" | "binding"
    kind: string,
    value: float,
    minimum: float,
    maximum: float,
    display: string,
    /// 10^decimals, so the field can round in Slint without a format string.
    round-factor: float,
    flag: bool,
    choice: string,
    options: [string],
}

struct PresetRow {
    slug: string,
    name: string,
    /// Loaded by the running profile. An edit to a preset nothing loads changes nothing, and
    /// that is worth saying before the user spends an evening on it.
    live: bool,
}

struct SlotRow {
    index: int,
    name: string,
    output: string,
    preset: string,
    is-default: bool,
    can-up: bool,
    can-down: bool,
}

struct ProfileRow {
    slug: string,
    name: string,
}

// Two or three options as segmented buttons, per gui.md. Every enum in the catalog has three
// options or fewer, so no dropdown is needed anywhere.
component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in property <string> chosen;
    callback picked(string);

    spacing: 0px;
    for opt in options: Rectangle {
        height: 26px;
        border-width: 1px;
        border-color: Theme.line;
        background: opt == chosen ? Theme.accent.with-alpha(0.18)
                  : (seg.has-hover ? Theme.line.with-alpha(0.5) : transparent);
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: opt;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: Theme.size-muted;
                color: opt == chosen ? Theme.accent : Theme.text;
            }
        }
        seg := TouchArea { clicked => { picked(opt); } }
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    callback switched(bool);

    width: 42px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
    background: on ? Theme.accent.with-alpha(0.35) : Theme.line.with-alpha(0.4);

    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? Theme.accent : Theme.muted;
    }
    TouchArea { clicked => { root.switched(!root.on); } }
}

// A text field that is obviously one.
//
// The first version put the placeholder *in* the layout beside the input, which left the
// input with no width to click on — it looked like a label and behaved like nothing. The
// placeholder is now drawn behind the input rather than beside it, the input fills the field,
// and a text cursor over the whole thing says it can be typed in before anyone tries.
component Field inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback committed(string);

    height: 30px;
    min-width: 120px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: inner.has-focus ? Theme.accent : Theme.line;
    background: Theme.ground;

    // Keyed on what the *input* holds, not on the property it was seeded with. Keying it on
    // the property left the placeholder sitting over text the user had typed the moment focus
    // moved away, because the property never changes for a field that starts empty.
    if inner.text == "": Text {
        x: 9px;
        text: root.placeholder;
        font-size: Theme.size-muted;
        color: Theme.muted;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { inner.focus(); }
    }

    inner := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: 100%;
        text: root.text;
        font-size: Theme.size-base;
        font-family: "monospace";
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.committed(self.text); self.clear-focus(); }
    }
}

// Press-to-bind. Best practice for this control is unglamorous and mostly about honesty:
// say plainly that it is listening, name what it captured, let Escape out, and never leave
// the user unable to tell whether it heard them.
//
// **Multiple bindings per parameter**, because one is a guess about which hand is free. Any
// of them engages the gesture; a chip removes the one it names.
component BindingControl inherits VerticalLayout {
    in property <[string]> bound;
    in property <bool> listening;
    callback listen();
    callback cancel();
    callback remove(string);

    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;
        alignment: start;

        for name in bound: Rectangle {
            height: 26px;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.45);
            background: Theme.accent.with-alpha(0.12);
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 6px;
                Text {
                    text: name;
                    font-family: "monospace";
                    font-size: Theme.size-muted;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Text {
                    text: "×";
                    font-size: Theme.size-base;
                    color: chip.has-hover ? Theme.error : Theme.muted;
                    vertical-alignment: center;
                }
            }
            chip := TouchArea { clicked => { root.remove(name); } }
        }

        if root.bound.length == 0 && !root.listening: Text {
            text: "nothing bound";
            font-size: Theme.size-muted;
            color: Theme.muted;
            vertical-alignment: center;
            height: 26px;
        }

        if !root.listening: Button {
            label: root.bound.length == 0 ? "Bind…" : "Add…";
            clicked => { root.listen(); }
        }

        // While listening the control says so, says how to stop, and offers the way out —
        // a control that silently waits is one the user cannot tell from a broken one.
        if root.listening: Rectangle {
            height: 26px;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.accent.with-alpha(0.15);
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: "Press a button or key…  (Esc to cancel)";
                    font-size: Theme.size-muted;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }
        }
        if root.listening: Button {
            label: "Cancel";
            clicked => { root.cancel(); }
        }
    }
}

// A slider track, hand-rolled to match the rest rather than importing a widget set whose
// metrics and colours would not follow Theme.
component Track inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> value;
    callback moved(float);
    /// Fired once when the hand lets go. The write happens here rather than per frame.
    callback committed(float);

    height: 22px;
    property <float> span: max(root.maximum - root.minimum, 0.000001);
    property <float> frac: clamp((root.value - root.minimum) / root.span, 0.0, 1.0);

    Rectangle {
        y: root.height / 2 - 2px;
        height: 4px;
        border-radius: 2px;
        background: Theme.line;
    }
    Rectangle {
        x: 0px;
        y: root.height / 2 - 2px;
        width: root.width * root.frac;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent.with-alpha(0.7);
    }
    Rectangle {
        x: root.width * root.frac - 7px;
        y: root.height / 2 - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.accent;
    }
    TouchArea {
        moved => {
            root.moved(root.minimum + root.span * clamp(self.mouse-x / root.width, 0.0, 1.0));
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.moved(root.minimum + root.span * clamp(self.mouse-x / root.width, 0.0, 1.0));
            }
            // One write per drag, not one per frame. Writing continuously filled the undo
            // stack with hundreds of entries for a single adjustment and made the daemon
            // reload its whole config on every pixel of travel.
            if (ev.kind == PointerEventKind.up) {
                root.committed(root.value);
            }
        }
    }
}

// Slider and numeric field, side by side, always both (gui.md). The slider spans the
// recommended range and the field accepts anything past it.
component ParamControl inherits Rectangle {
    in property <EditorRow> param;
    in property <bool> show-keys;
    callback changed(float);

    height: 54px;

    // **The control owns the value while it is being dragged.**
    //
    // It used to read straight from the model, and every drag tick wrote the file, which
    // rebuilt the model, which reset the handle underneath the hand — the slider fought back.
    // Holding the value here means the drag is smooth and the model is free to arrive late.
    property <float> live: root.param.value;

    // **Typing into a TextInput removes its `text` binding for good.**
    //
    // So a field that had been edited once never followed the slider again — it kept whatever
    // was last typed while the handle moved beside it. The text is therefore *pushed* on every
    // change of `live` rather than bound to it. Safe while typing, because `live` does not
    // move until the edit is committed.
    changed live => {
        input.text = round(root.live * root.param.round-factor) / root.param.round-factor;
    }

    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: Theme.gap;
            Text {
                text: root.param.label;
                font-size: Theme.size-base;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.show-keys: Text {
                text: root.param.key;
                font-family: "monospace";
                font-size: Theme.size-muted;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            Track {
                horizontal-stretch: 1;
                // **The range stretches to hold whatever the field says.**
                //
                // Typing a value past the recommended range pinned the handle at the end, and
                // the next drag then snapped back inside it — the field and the slider
                // disagreed about the value, and the slider won. Widening here keeps "fields
                // decide" true after the typing as well as during it.
                minimum: min(root.param.minimum, root.live);
                maximum: max(root.param.maximum, root.live);
                value: root.live;
                // Moving only updates what is on screen; the value is written when the hand
                // lets go, so a drag is one change rather than several hundred.
                moved(v) => { root.live = v; }
                committed(v) => { root.changed(v); }
            }
            Rectangle {
                width: 92px;
                border-radius: Theme.radius-control;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.line;
                background: Theme.ground;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;
                    input := TextInput {
                        // Seeded once, then kept in step by the `changed live` handler above —
                        // a binding here would be destroyed by the first keystroke.
                        text: round(root.param.value * root.param.round-factor)
                              / root.param.round-factor;
                        font-size: Theme.size-base;
                        font-family: "monospace";
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        single-line: true;
                        accepted => {
                            root.live = self.text.to-float();
                            root.changed(root.live);
                            self.clear-focus();
                        }
                    }
                    Text {
                        text: root.param.unit;
                        font-size: Theme.size-muted;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

struct ModeRow {
    slot: int,
    name: string,
    output: string,
    preset: string,
}

export component App inherits Window {
    title: "StabMouse";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 1000px;
    min-height: 700px;
    background: Theme.ground;

    in property <bool> connected;
    in property <string> profile;
    /// The profile the daemon is actually running, by slug — the display name is decoration
    /// and two profiles may share one.
    in property <string> active-profile-slug;
    in property <int> active-slot;
    in property <string> mode-name;
    in property <bool> enabled;
    in property <bool> degraded;
    in property <string> degraded-reason;
    in property <int> tablets;
    in property <bool> tablets-placed;
    in property <string> version;
    in property <[ModeRow]> modes;
    in property <[string]> stages;

    // Preset editor.
    in property <[PresetRow]> presets;
    in property <[EditorRow]> params;
    in property <[string]> stage-kinds;
    in-out property <int> selected-preset;
    in property <string> selected-preset-path;
    /// Presets the running profile actually loads, so editing one that is not live is not a
    /// silent no-op.
    in property <[string]> live-presets;

    // Profile editor.
    in property <[ProfileRow]> profiles;
    in property <[SlotRow]> slots;
    in-out property <int> selected-profile;
    in property <string> selected-profile-path;
    /// The profile the daemon will start with, which is not necessarily the running one.
    in property <string> startup-profile-slug;
    in property <[string]> outputs;
    in property <[string]> preset-slugs;

    in property <string> notice;
    in property <string> undo-label;
    // Which parameter is currently listening, as "stageIndex/key", empty when none.
    in-out property <string> listening-for;

    property <string> page: "dashboard";
    property <bool> show-keys: false;

    callback switch-to(int);
    callback set-enabled(bool);
    callback refresh();

    callback select-preset(int);
    callback create-preset(string);
    callback delete-preset();
    callback add-stage(string);
    callback remove-stage(int);
    callback move-stage(int, int);
    callback set-stage-enabled(int, bool);
    callback set-param-float(int, string, float);
    callback set-param-bool(int, string, bool);
    callback set-param-text(int, string, string);

    callback select-profile(int);
    callback create-profile(string);
    callback delete-profile();
    callback add-slot();
    callback remove-slot(int);
    callback move-slot(int, int);
    callback set-slot-field(int, string, string);
    callback set-default-slot(int);
    callback undo();
    callback listen-binding(int, string);
    callback key-down(string, bool, bool, bool, bool);
    callback key-up(string);
    callback cancel-listen();
    callback remove-binding(int, string, string);
    callback forget-param(int, string);
    callback switch-profile(string);
    callback make-startup-profile(string);

    // Keys are captured here, buttons by the daemon — each side sees what only it can see.
    // Escape leaves, which is the way out every capture control owes the user.
    keycap := FocusScope {
        key-pressed(event) => {
            if (listening-for == "") {
                return reject;
            }
            if (event.text == Key.Escape) {
                cancel-listen();
                return accept;
            }
            key-down(event.text, event.modifiers.control, event.modifiers.alt,
                     event.modifiers.shift, event.modifiers.meta);
            accept
        }
        key-released(event) => {
            if (listening-for == "") {
                return reject;
            }
            key-up(event.text);
            accept
        }
    }

    HorizontalLayout {
        // -------------------------------------------------------------- sidebar
        Rectangle {
            width: 200px;
            background: Theme.surface;

            VerticalLayout {
                padding: Theme.gap;
                spacing: 2px;

                Text {
                    text: "StabMouse";
                    font-size: Theme.size-heading;
                    font-weight: 600;
                    color: Theme.text;
                    height: 40px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }

                NavItem {
                    label: "Dashboard";
                    selected: page == "dashboard";
                    clicked => { page = "dashboard"; }
                }
                // Honest about what exists. A navigation item that opens nothing is worse
                // than one that says it is not built yet.
                NavItem {
                    label: "Profiles";
                    selected: page == "profiles";
                    clicked => { page = "profiles"; }
                }
                NavItem {
                    label: "Presets";
                    selected: page == "presets";
                    clicked => { page = "presets"; }
                }
                NavItem { label: "Devices"; enabled-item: false; }

                Rectangle { vertical-stretch: 1; }

                // Persistent status area in the sidebar footer (gui.md).
                Rectangle { height: 1px; background: Theme.line; }
                VerticalLayout {
                    padding-top: Theme.gap;
                    spacing: 2px;
                    Text {
                        text: connected ? "Daemon connected" : "No daemon";
                        font-size: Theme.size-muted;
                        color: connected ? Theme.success : Theme.error;
                    }
                    Text {
                        text: connected ? "v" + version : "start it with stabmoused run";
                        font-size: Theme.size-muted;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.line; }

        // ------------------------------------------------------------ dashboard
        if page == "dashboard": Rectangle {
            background: Theme.ground;

            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.pad;

                HorizontalLayout {
                    height: 32px;
                    Text {
                        text: "Dashboard";
                        font-size: Theme.size-heading;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        label: "Refresh";
                        clicked => { root.refresh(); }
                    }
                }

                if !connected: NoticeCard {
                    title: "No daemon is running";
                    body: "StabMouse filters input from a background daemon. Start one with "
                        + "`stabmoused run`, then press Refresh.";
                    tone: Theme.error;
                    action: "Refresh";
                    acted => { root.refresh(); }
                }

                // A button label is a thin signal for "your mouse is no longer being
                // filtered". Disabled is a state worth stating outright, in the flow, because
                // the alternative is a user wondering why their curves stopped working.
                if connected && !enabled: NoticeCard {
                    title: "Filtering is off";
                    body: "The grab is released, so the mouse behaves as it would without "
                        + "StabMouse. Nothing is lost — modes and presets are untouched.";
                    tone: Theme.warning;
                    action: "Enable";
                    acted => { root.set-enabled(true); }
                }

                if connected && degraded: NoticeCard {
                    title: "Output is limited";
                    body: degraded-reason;
                    tone: Theme.warning;
                }

                if connected: Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.gap;

                        HorizontalLayout {
                            spacing: Theme.gap;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Mode " + active-slot + " — " + mode-name;
                                    font-size: Theme.size-heading;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "profile: " + profile;
                                    font-size: Theme.size-muted;
                                    color: Theme.muted;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                label: enabled ? "Disable" : "Enable";
                                danger: enabled;
                                primary: !enabled;
                                clicked => { root.set-enabled(!enabled); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.line; }

                        Text {
                            text: "Pipeline";
                            font-size: Theme.size-muted;
                            color: Theme.muted;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for stage in stages: PipelineStage { label: stage; }
                        }
                    }
                }

                if connected: Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.gap;

                        Text {
                            text: "Modes";
                            font-size: Theme.size-muted;
                            color: Theme.muted;
                        }

                        for mode in modes: Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-control;
                            background: mode.slot == active-slot
                                ? Theme.accent.with-alpha(0.14)
                                : (row-touch.has-hover ? Theme.line.with-alpha(0.4) : transparent);

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: Theme.gap;

                                Text {
                                    text: mode.slot;
                                    width: 20px;
                                    font-family: "monospace";
                                    font-size: Theme.size-muted;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: mode.name;
                                    width: 140px;
                                    font-size: Theme.size-base;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: mode.output;
                                    width: 90px;
                                    font-family: "monospace";
                                    font-size: Theme.size-muted;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: mode.preset;
                                    font-family: "monospace";
                                    font-size: Theme.size-muted;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            row-touch := TouchArea {
                                clicked => { root.switch-to(mode.slot); }
                            }
                        }
                    }
                }

                if connected && tablets > 0: Card {
                    vertical-stretch: 0;
                    HorizontalLayout {
                        padding: Theme.pad;
                        spacing: Theme.gap;
                        Text {
                            text: "Tablets";
                            font-size: Theme.size-muted;
                            color: Theme.muted;
                            vertical-alignment: center;
                            width: 80px;
                        }
                        Text {
                            text: tablets + (tablets-placed
                                ? " — one per screen, each confined to its own"
                                : " — not confined to their screens");
                            font-size: Theme.size-base;
                            color: tablets-placed ? Theme.text : Theme.warning;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ------------------------------------------------------------- presets
        //
        // Edits land in the preset file and the daemon's own watch picks them up within about
        // 0.4s, so the loop is: change, draw, judge. Every filter finding in this project came
        // from drawing rather than from reasoning, which is why this exists at all.
        if page == "presets": Rectangle {
            background: Theme.ground;
            HorizontalLayout {
                Rectangle {
                    width: 220px;
                    background: Theme.surface;
                    VerticalLayout {
                        padding: Theme.gap;
                        spacing: 2px;
                        Text {
                            text: "Presets";
                            font-size: Theme.size-heading;
                            font-weight: 600;
                            color: Theme.text;
                            height: 40px;
                            vertical-alignment: center;
                        }
                        for entry[i] in presets: NavItem {
                            label: entry.live ? entry.name + "  ●" : entry.name;
                            selected: i == selected-preset;
                            clicked => { selected-preset = i; select-preset(i); }
                        }
                        Rectangle { height: Theme.gap; }
                        Field {
                            placeholder: "New preset name…";
                            committed(name) => { create-preset(name); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle { width: 1px; background: Theme.line; }

                Rectangle {
                    background: Theme.ground;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.gap;

                        HorizontalLayout {
                            height: 32px;
                            spacing: Theme.gap;
                            Text {
                                text: presets.length > 0 ? presets[selected-preset].name : "No presets";
                                font-size: Theme.size-heading;
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if undo-label != "": Button {
                                label: "Undo " + undo-label;
                                clicked => { undo(); }
                            }
                            Button {
                                label: show-keys ? "Hide keys" : "Show keys";
                                clicked => { show-keys = !show-keys; }
                            }
                            if presets.length > 0: Button {
                                label: "Delete preset";
                                danger: true;
                                clicked => { delete-preset(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.gap;
                            Text {
                                text: selected-preset-path;
                                font-family: "monospace";
                                font-size: Theme.size-muted;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if presets.length > 0 && !presets[selected-preset].live: Text {
                                text: "not loaded by the running profile";
                                font-size: Theme.size-muted;
                                color: Theme.warning;
                                vertical-alignment: center;
                            }
                        }

                        if notice != "": NoticeCard {
                            title: "Config";
                            body: notice;
                            tone: Theme.warning;
                        }

                        // Add a stage. Every kind the config accepts, so the editor never
                        // offers less than the file format does.
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Add:";
                                font-size: Theme.size-muted;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            for kind in stage-kinds: Button {
                                label: kind;
                                clicked => { add-stage(kind); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            viewport-height: content.preferred-height;
                            content := VerticalLayout {
                                spacing: 4px;

                                for pr[i] in params: VerticalLayout {
                                    spacing: 4px;
                                    padding-top: pr.is-header && i > 0 ? 14px : 0px;

                                    // A heading sits flush against the parameters beneath it,
                                    // which are inset and share a spine down the left. Without
                                    // that, a flat list of sliders gives no clue which stage
                                    // any given value belongs to.
                                    if pr.is-header: Rectangle {
                                        height: 44px;
                                        background: pr.stage-enabled
                                            ? Theme.accent.with-alpha(0.10)
                                            : Theme.surface;
                                        border-radius: Theme.radius-card;
                                        border-width: 1px;
                                        border-color: pr.stage-enabled
                                            ? Theme.accent.with-alpha(0.35)
                                            : Theme.line;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 6px;
                                            Text {
                                                text: pr.stage-label;
                                                font-size: Theme.size-base;
                                                font-weight: 600;
                                                color: pr.stage-enabled ? Theme.text : Theme.muted;
                                                vertical-alignment: center;
                                            }
                                            if show-keys: Text {
                                                text: pr.stage-kind;
                                                font-family: "monospace";
                                                font-size: Theme.size-muted;
                                                color: Theme.muted;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            // Pinned stages cannot move: normalize must be
                                            // first and pressure last, and an arrow that
                                            // silently undoes itself is worse than none.
                                            if pr.can-up: Button {
                                                label: "↑";
                                                clicked => { move-stage(pr.stage-index, -1); }
                                            }
                                            if pr.can-down: Button {
                                                label: "↓";
                                                clicked => { move-stage(pr.stage-index, 1); }
                                            }
                                            Toggle {
                                                on: pr.stage-enabled;
                                                switched(v) => { set-stage-enabled(pr.stage-index, v); }
                                            }
                                            Button {
                                                label: "Remove";
                                                danger: true;
                                                clicked => { remove-stage(pr.stage-index); }
                                            }
                                        }
                                    }

                                    if !pr.is-header && pr.kind == "float": HorizontalLayout {
                                        spacing: 0px;
                                        Rectangle { width: 10px; }
                                        Rectangle {
                                            width: 2px;
                                            background: pr.stage-enabled
                                                ? Theme.accent.with-alpha(0.35)
                                                : Theme.line;
                                        }
                                        Rectangle { width: 12px; }
                                        ParamControl {
                                            horizontal-stretch: 1;
                                            param: pr;
                                            show-keys: show-keys;
                                            changed(v) => { set-param-float(pr.stage-index, pr.key, v); }
                                        }
                                    }

                                    if !pr.is-header && pr.kind != "float": HorizontalLayout {
                                        height: pr.kind == "binding" ? 44px : 36px;
                                        spacing: 0px;
                                        Rectangle { width: 10px; }
                                        Rectangle {
                                            width: 2px;
                                            background: pr.stage-enabled
                                                ? Theme.accent.with-alpha(0.35)
                                                : Theme.line;
                                        }
                                        Rectangle { width: 12px; }
                                        Text {
                                            text: pr.kind == "legacy"
                                                ? pr.label + "  (no longer used)" : pr.label;
                                            font-size: Theme.size-base;
                                            color: pr.kind == "legacy" ? Theme.muted : Theme.text;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { width: Theme.gap; }
                                        if show-keys: Text {
                                            text: pr.key;
                                            font-family: "monospace";
                                            font-size: Theme.size-muted;
                                            color: Theme.muted;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        if pr.kind == "bool": Toggle {
                                            on: pr.flag;
                                            switched(v) => { set-param-bool(pr.stage-index, pr.key, v); }
                                        }
                                        if pr.kind == "choice": Segmented {
                                            options: pr.options;
                                            chosen: pr.choice;
                                            picked(v) => { set-param-text(pr.stage-index, pr.key, v); }
                                        }
                                        // A key this build no longer reads. Shown so the
                                        // editor never implies the preset is simpler than it
                                        // is, with a way to be rid of it.
                                        if pr.kind == "legacy": Text {
                                            text: pr.choice;
                                            font-family: "monospace";
                                            font-size: Theme.size-muted;
                                            color: Theme.muted;
                                            vertical-alignment: center;
                                        }
                                        if pr.kind == "legacy": Button {
                                            label: "Remove";
                                            danger: true;
                                            clicked => { forget-param(pr.stage-index, pr.key); }
                                        }
                                        if pr.kind == "binding": BindingControl {
                                            bound: pr.options;
                                            listening: listening-for == pr.stage-index + "/" + pr.key;
                                            listen() => {
                                                // The scope must hold focus before the user
                                                // presses anything, or the first key is lost.
                                                keycap.focus();
                                                listen-binding(pr.stage-index, pr.key);
                                            }
                                            cancel() => { cancel-listen(); }
                                            remove(name) => { remove-binding(pr.stage-index, pr.key, name); }
                                        }
                                    }

                                    if !pr.is-header && show-keys && pr.help != "": HorizontalLayout {
                                        spacing: 0px;
                                        Rectangle { width: 10px; }
                                        Rectangle {
                                            width: 2px;
                                            background: pr.stage-enabled
                                                ? Theme.accent.with-alpha(0.35)
                                                : Theme.line;
                                        }
                                        Rectangle { width: 12px; }
                                        Text {
                                            text: pr.help;
                                            font-size: Theme.size-muted;
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }

                                if params.length == 0 && presets.length > 0: Text {
                                    text: "This preset has no stages. Add one above.";
                                    font-size: Theme.size-muted;
                                    color: Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------ profiles
        //
        // A profile is the list the mode toggle cycles through, so this is where a preset
        // becomes something reachable by a hotkey.
        if page == "profiles": Rectangle {
            background: Theme.ground;
            HorizontalLayout {
                Rectangle {
                    width: 220px;
                    background: Theme.surface;
                    VerticalLayout {
                        padding: Theme.gap;
                        spacing: 2px;
                        Text {
                            text: "Profiles";
                            font-size: Theme.size-heading;
                            font-weight: 600;
                            color: Theme.text;
                            height: 40px;
                            vertical-alignment: center;
                        }
                        for entry[i] in profiles: NavItem {
                            // The running profile is marked in the list, not only in the
                            // header — otherwise "which one is live" needs a click to answer.
                            label: entry.slug == active-profile-slug
                                ? entry.name + "  ●" : entry.name;
                            selected: i == selected-profile;
                            clicked => { selected-profile = i; select-profile(i); }
                        }
                        Rectangle { height: Theme.gap; }
                        Field {
                            placeholder: "New profile name…";
                            committed(name) => { create-profile(name); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle { width: 1px; background: Theme.line; }

                Rectangle {
                    background: Theme.ground;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.gap;

                        HorizontalLayout {
                            height: 32px;
                            spacing: Theme.gap;
                            Text {
                                text: profiles.length > 0 ? profiles[selected-profile].name : "No profiles";
                                font-size: Theme.size-heading;
                                font-weight: 600;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // Switching is a daemon action, not a file edit, so it sits apart
                            // from the editing controls and says which profile is live.
                            // Compared by slug, not by display name: the name is decoration
                            // and need not be unique, so comparing it left the button offering
                            // to switch to the profile already running.
                            if profiles.length > 0 && connected
                                && profiles[selected-profile].slug != active-profile-slug: Button {
                                label: "Switch to this";
                                primary: true;
                                clicked => { switch-profile(profiles[selected-profile].slug); }
                            }
                            if profiles.length > 0 && connected
                                && profiles[selected-profile].slug == active-profile-slug: Text {
                                text: "● running";
                                font-size: Theme.size-muted;
                                color: Theme.success;
                                vertical-alignment: center;
                            }
                            // Switching is a runtime action and does not survive a restart.
                            // Without a way to say "and mean it", a restarted daemon quietly
                            // went back to the old profile and every edit since looked inert.
                            if profiles.length > 0
                                && profiles[selected-profile].slug != startup-profile-slug: Button {
                                label: "Use on startup";
                                clicked => { make-startup-profile(profiles[selected-profile].slug); }
                            }
                            if profiles.length > 0
                                && profiles[selected-profile].slug == startup-profile-slug: Text {
                                text: "starts by default";
                                font-size: Theme.size-muted;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            if undo-label != "": Button {
                                label: "Undo " + undo-label;
                                clicked => { undo(); }
                            }
                            if profiles.length > 0: Button {
                                label: "Add slot";
                                primary: true;
                                clicked => { add-slot(); }
                            }
                            if profiles.length > 0: Button {
                                label: "Delete profile";
                                danger: true;
                                clicked => { delete-profile(); }
                            }
                        }

                        Text {
                            text: selected-profile-path;
                            font-family: "monospace";
                            font-size: Theme.size-muted;
                            color: Theme.muted;
                        }

                        if notice != "": NoticeCard {
                            title: "Config";
                            body: notice;
                            tone: Theme.warning;
                        }

                        Flickable {
                            vertical-stretch: 1;
                            viewport-height: slotlist.preferred-height;
                            slotlist := VerticalLayout {
                                spacing: 6px;

                                for slot[i] in slots: Rectangle {
                                    height: 84px;
                                    background: Theme.surface;
                                    border-radius: Theme.radius-card;
                                    border-width: 1px;
                                    border-color: Theme.line;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: Theme.gap;
                                            Text {
                                                text: "Slot " + (slot.index + 1);
                                                font-size: Theme.size-muted;
                                                color: Theme.muted;
                                                vertical-alignment: center;
                                                width: 48px;
                                            }
                                            Field {
                                                width: 160px;
                                                text: slot.name;
                                                placeholder: "Name";
                                                committed(v) => { set-slot-field(slot.index, "name", v); }
                                            }
                                            Segmented {
                                                options: outputs;
                                                chosen: slot.output;
                                                picked(v) => { set-slot-field(slot.index, "output", v); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if slot.can-up: Button {
                                                label: "↑";
                                                clicked => { move-slot(slot.index, -1); }
                                            }
                                            if slot.can-down: Button {
                                                label: "↓";
                                                clicked => { move-slot(slot.index, 1); }
                                            }
                                            Button {
                                                label: "Remove";
                                                danger: true;
                                                clicked => { remove-slot(slot.index); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: "Preset:";
                                                font-size: Theme.size-muted;
                                                color: Theme.muted;
                                                vertical-alignment: center;
                                                width: 48px;
                                            }
                                            for name in preset-slugs: Button {
                                                label: name;
                                                primary: name == slot.preset;
                                                clicked => { set-slot-field(slot.index, "preset", name); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Button {
                                                label: slot.is-default ? "Default" : "Make default";
                                                primary: slot.is-default;
                                                clicked => { set-default-slot(slot.index); }
                                            }
                                        }
                                    }
                                }

                                if slots.length == 0 && profiles.length > 0: Text {
                                    text: "This profile has no slots. Add one above.";
                                    font-size: Theme.size-muted;
                                    color: Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
